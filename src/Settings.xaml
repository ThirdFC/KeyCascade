<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyCascade Settings" Width="1140" Height="860" MinWidth="940" MinHeight="620"
        Background="#0D121B" Foreground="#E8EFF7" FontFamily="Microsoft YaHei UI" FontSize="12"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#65E2CD"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#253344"/><Setter Property="Foreground" Value="#E8EFF7"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border><ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.6"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#EDF5FF"/><Setter Property="Background" Value="#101923"/>
            <Setter Property="BorderBrush" Value="#304152"/><Setter Property="Padding" Value="9,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CaretBrush" Value="#65E2CD"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D5E0ED"/><Setter Property="Margin" Value="0,8,20,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#8EA1B6"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#151F2B"/><Setter Property="BorderBrush" Value="#263443"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1D2B3A"/><Setter Property="Foreground" Value="#9DAFC2"/>
            <Setter Property="Padding" Value="9,11"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#DCE8F4"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7,6"/>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#274153"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#111B26"/><Setter Property="MinHeight" Value="34"/>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#213748"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
    </Window.Resources>
    <Grid Background="#0D121B">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="26,22,26,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="KEYCASCADE" Foreground="#65E2CD" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="让每一次击键，都看得见。" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,5"/>
                <TextBlock Text="按键瀑布流  /  透明悬浮  /  游戏上方置顶" Foreground="#8EA1B6"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PreviewButton" Content="试播 4 秒"/>
                <Button x:Name="VisibilityButton" Content="隐藏悬浮窗" Margin="0"/>
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,0,26,0">
            <StackPanel>
                <Border Style="{StaticResource Card}" Background="#142A2C" BorderBrush="#265354" Padding="16,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock x:Name="LiveStatus" Text="●  全局监听已启动 · 悬浮窗置顶中" Foreground="#78E7CD" FontWeight="SemiBold"/>
                            <TextBlock Text="直接按下绑定的按键即可查看。长按显示长条，松开后向上消退。" Foreground="#9AB8BD" Margin="0,6,0,0"/>
                            <TextBlock x:Name="FrameStatus" Text="动画刷新：跟随屏幕 · 待机" Foreground="#8EA1B6" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Ctrl + Alt + F8  打开设置" Foreground="#A8D6D0" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="01  /  按键布局" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="每一行是一列瀑布流。编辑标签、尺寸、颜色与独立偏移，最多 32 键。" Foreground="#8EA1B6" Margin="0,6,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="FourKeyButton" Content="4 键"/><Button x:Name="SevenKeyButton" Content="7 键"/><Button x:Name="EightKeyButton" Content="8 键" Margin="0"/></StackPanel>
                        </Grid>
                        <DataGrid x:Name="KeysGrid" Margin="0,16,0,12" Height="284" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E2D3C" Background="#111B26" BorderThickness="0" RowHeaderWidth="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="显示标签" Width="*" MinWidth="80" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="绑定键" Width="94" Binding="{Binding Binding}" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTemplateColumn Header="" Width="32"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="13" Height="13" CornerRadius="3" Background="{Binding Color}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="颜色 HEX" Width="102" Binding="{Binding Color, UpdateSourceTrigger=PropertyChanged}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="宽度" Width="74" Binding="{Binding Width, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="高度" Width="74" Binding="{Binding Height, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="X 偏移" Width="78" Binding="{Binding OffsetX, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Y 偏移" Width="78" Binding="{Binding OffsetY, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel><Button x:Name="AddButton" Content="+ 添加按键"/><Button x:Name="BindButton" Content="录入绑定"/><Button x:Name="ColorButton" Content="选择颜色"/><Button x:Name="UpButton" Content="上移"/><Button x:Name="DownButton" Content="下移"/><Button x:Name="DeleteButton" Content="删除" Background="#3B2836"/><TextBlock x:Name="KeyCount" Foreground="#8EA1B6" VerticalAlignment="Center"/></WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="02  /  悬浮窗与瀑布流" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="坐标与尺寸使用 Windows 逻辑像素（DIP），支持多显示器与负坐标。" Foreground="#8EA1B6" Margin="0,6,0,0"/></StackPanel>
                            <Button Grid.Column="1" x:Name="PlaceButton" Content="放到当前屏幕底部" VerticalAlignment="Center" Margin="0"/>
                        </Grid>
                        <Grid Margin="0,18,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0"><TextBlock Text="窗口 X 坐标" Style="{StaticResource Caption}"/><TextBox x:Name="LeftBox"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="窗口 Y 坐标" Style="{StaticResource Caption}"/><TextBox x:Name="TopBox"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,16,0"><TextBlock Text="瀑布高度 · 40–1800" Style="{StaticResource Caption}"/><TextBox x:Name="TrailBox"/></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="上升速度 · 像素/秒" Style="{StaticResource Caption}"/><TextBox x:Name="SpeedBox"/></StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0"><TextBlock Text="按键间距 · 0–100" Style="{StaticResource Caption}"/><TextBox x:Name="GapBox"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="显示不透明度 · 15–100%" Style="{StaticResource Caption}"/><TextBox x:Name="OpacityBox"/></StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,16,0"><TextBlock Text="背景不透明度 · 0–100%" Style="{StaticResource Caption}"/><TextBox x:Name="BackgroundBox"/></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="快速定位" Style="{StaticResource Caption}"/><Button x:Name="DragButton" Content="启用拖动模式" Margin="0"/></StackPanel>
                        </Grid>
                        <WrapPanel><CheckBox x:Name="ThroughCheck" Content="鼠标穿透（推荐游戏时开启）"/><CheckBox x:Name="CountCheck" Content="显示按键计数"/><CheckBox x:Name="FadeCheck" Content="尾迹渐隐"/></WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Background="#111A25">
                    <StackPanel><TextBlock Text="快捷操作" FontSize="14" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,10,0,8"><TextBlock Text="Ctrl+Alt+F8  设置" Margin="0,0,26,0"/><TextBlock Text="Ctrl+Alt+F9  穿透 / 拖动" Margin="0,0,26,0"/><TextBlock Text="Ctrl+Alt+F10  显示 / 隐藏" Margin="0,0,26,0"/><TextBlock Text="Ctrl+Alt+F11  清零计数"/></WrapPanel>
                        <TextBlock Text="关闭设置窗口后，悬浮窗仍在运行。右下角托盘图标可打开设置或退出。" Foreground="#8EA1B6" TextWrapping="Wrap"/>
                        <TextBlock Text="请使用窗口化或无边框全屏游戏；独占全屏可能无法显示桌面悬浮窗。" Foreground="#D1B47A" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,14,0,0"><Button x:Name="ImportButton" Content="导入配置"/><Button x:Name="ExportButton" Content="导出配置"/><Button x:Name="ResetButton" Content="恢复默认布局"/><Button x:Name="ResetCountsButton" Content="清零计数"/><Button x:Name="ExitButton" Content="退出程序" Background="#3B2836"/></WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#17222F" BorderBrush="#293747" BorderThickness="0,1,0,0" Padding="26,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="MessageText" Text="修改后点击「应用并保存」。" Foreground="#A3B5C8" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,18,0"/>
                <Button Grid.Column="1" x:Name="HideSettingsButton" Content="收起设置"/>
                <Button Grid.Column="2" x:Name="ApplyButton" Content="应用并保存" Background="#65E2CD" Foreground="#10221F" FontWeight="Bold" Padding="24,10" Margin="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
